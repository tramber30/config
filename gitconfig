[user]
	email = $EMAIL 
	name = $NAME
[core]
	editor = vim
	askpass = 
        pager = more
[color]
	branch = auto
	diff = auto
	interactive = auto
	status = auto
	ui = always

[diff]
	tool = vimdiff
[alias]
	br = branch
	ck = checkout
	com = commit
	st = status
	sh = show
	lc = log --stat --no-merges
	lg = log --graph --pretty=tformat:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%an %cr)%Creset' --abbrev-commit --date=relative
	tmp = commit -a -m "tmp"
	cp = cherry-pick
	amend = commit --amend
[format]
	headers = "Content-Type: text/plain; charset=\"utf-8\"\nContent-Transfer-Encoding: 8bit\n"
[mergetool]
	keepbackup = false
[help]
	autocorrect = 1
[merge]
	tool = vimdiff
[difftool]
	prompt = false
